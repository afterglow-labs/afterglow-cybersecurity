    "Choose an agent and model profile to work with your APTEX server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an agent and model profile to work with your APTEX server."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "APTEX 서버에서 사용할 에이전트와 모델 프로필을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要在 APTEX 服务器上使用的智能体和模型配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要在 APTEX 伺服器上使用的代理程式與模型設定檔。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APTEX サーバーで使用するエージェントとモデルプロファイルを選択してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un agente y un perfil de modelo para trabajar con tu servidor APTEX."
          }
        }
      }
    },
    "Client only. No server or model runtime runs on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Client only. No server or model runtime runs on this device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 클라이언트 전용입니다. 이 기기에서는 서버나 모델 런타임을 실행하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用仅为客户端，不在此设备上运行服务器或模型运行时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用程式僅為用戶端，不會在此裝置上執行伺服器或模型執行環境。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはクライアント専用です。このデバイスではサーバーやモデルの実行環境は動作しません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo es un cliente. Este dispositivo no ejecuta ningún servidor ni entorno de ejecución de modelos."
          }
        }
      }
    },
