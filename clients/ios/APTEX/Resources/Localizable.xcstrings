        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송 결과를 확인하지 못했습니다. 동일한 요청으로 안전하게 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
