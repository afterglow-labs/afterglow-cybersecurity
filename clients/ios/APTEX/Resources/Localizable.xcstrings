    "Graphs, workflows, traffic, interception, model settings, and advanced tools.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Graphs, workflows, traffic, interception, model settings, and advanced tools."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래프, 워크플로, 트래픽, 가로채기, 모델 설정 및 고급 도구를 사용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图谱、工作流、流量、拦截、模型设置及高级工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖譜、工作流程、流量、攔截、模型設定與進階工具。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラフ、ワークフロー、通信トラフィック、インターセプト、モデル設定、高度なツール。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafos, flujos de trabajo, tráfico, interceptación, ajustes de modelos y herramientas avanzadas."
