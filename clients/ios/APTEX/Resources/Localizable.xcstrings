    "Configure model profiles in Console to choose a model here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure model profiles in Console to choose a model here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 모델을 선택하려면 콘솔에서 모델 프로필을 설정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在控制台配置模型，随后即可在此选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在主控台建立模型設定檔，即可在此選擇模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでモデルを選択するには、コンソールでモデルプロファイルを設定してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura perfiles de modelo en la Consola para poder elegir uno aquí."
          }
        }
