    "Check Tasks or Console before creating another task. The creation result is unconfirmed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Tasks or Console before creating another task. The creation result is unconfirmed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 작업을 생성하기 전에 작업 목록이나 콘솔을 확인하세요. 생성 결과를 확인하지 못했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次创建任务前，请先检查任务列表或控制台。目前尚未确认创建结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再次建立任務前，請先檢查任務清單或主控台。目前尚未確認建立結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のタスクを作成する前に、タスク一覧またはコンソールを確認してください。作成結果を確認できていません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de crear otra tarea, revisa Tareas o la Consola. No se ha confirmado el resultado de la creación."
          }
        }
      }
    },
