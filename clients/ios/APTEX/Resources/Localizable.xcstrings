    "Your desktop runs assessments and models. This client connects to it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your desktop runs assessments and models. This client connects to it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 평가와 모델은 데스크톱에서 실행됩니다. 이 클라이언트는 해당 서버에 연결합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评估和模型在桌面电脑上运行，此客户端用于连接该电脑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "評估與模型會在桌上型電腦執行，此用戶端用於連線至該電腦。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "評価とモデルはデスクトップで実行されます。このクライアントはそのサーバーに接続します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu equipo de escritorio ejecuta las evaluaciones y los modelos. Este cliente se conecta a él."
          }
        }
      }
    },
