    "Use the same private DNS connection as your desktop setup, with APTEX's port.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the same private DNS connection as your desktop setup, with APTEX's port."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱 설정과 동일한 사설 DNS 주소에 APTEX 포트를 지정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用与桌面配置相同的私有 DNS 地址，并指定 APTEX 的端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用與桌面設定相同的私人 DNS 位址，並指定 APTEX 的連接埠。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップ設定と同じプライベート DNS アドレスに、APTEX のポートを指定してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la misma dirección DNS privada de tu equipo de escritorio, con el puerto de APTEX."
          }
        }
      }
