# Docker deployment configuration: copy to .env.
# Compose builds Afterglow locally from this checkout.
SCOPEWEAVER_LANGUAGE=en
# The administrator login name shown in the UI; Afterglow also works as an alias.
AFTERGLOW_ADMIN_USERNAME=Afterglow
POSTGRES_USER=artex
# Set a unique random password before starting Compose.
POSTGRES_PASSWORD=
ARTEX_TRAFFIC_INSECURE_UPSTREAM=false
POSTGRES_DB=artex

# Set either/both LLM keys, or configure them later in the application.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Native Ollama is optional; cloud providers and external compatible endpoints remain supported.
# auto starts the managed runtime only when usable local weights are available.
# false starts the application without its managed Ollama service.
APTEX_LOCAL_MODEL_ENABLED=auto
# Explicit credentialed cross-origin clients, normally only a separate dev UI.
# Leave empty for same-origin production clients. Example: http://localhost:3000
APTEX_ALLOWED_ORIGINS=
# For host Ollama from Docker: http://host.docker.internal:11434
# For the optional Compose service: http://ollama:11434
OLLAMA_API_KEY=

# Optional generic credential override; leave this unset to use provider-specific keys.
# SCOPEWEAVER_LLM_API_KEY=your-key
SCOPEWEAVER_LLM_PROVIDER=
SCOPEWEAVER_LLM_MODEL=
SCOPEWEAVER_LLM_BASE_URL=
SCOPEWEAVER_LLM_PROXY=
SCOPEWEAVER_LOCAL_LLM_ONLY=false
# Optional native runtime overrides (unset uses provider defaults).
SCOPEWEAVER_LLM_CONTEXT_WINDOW_K=
SCOPEWEAVER_LLM_KEEP_ALIVE=
SCOPEWEAVER_LLM_MAX_CONCURRENT=
# Optional extra VPN/private network CIDRs when strict local mode is enabled.
SCOPEWEAVER_LOCAL_LLM_ALLOWED_CIDRS=

# Optional C2 operator handoff. Place binaries in private/c2-binaries/;
# they are mounted read-only and never delivered by the app.
ARTEX_ENABLE_C2_HANDOFF=false
ARTEX_C2_BIN_X64=
ARTEX_C2_BIN_X86=

# Optional Telegram user MCP connection. Sending is denied until an exact
# destination allowlist is set. Connect the stdio server manually in System → MCP.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_ALLOWED_CHATS=
