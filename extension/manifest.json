{
  "manifest_version": 3,
  "name": "Afterglow Traffic Capture",
  "version": "1.0.0",
  "description": "Capture an authorized tab's traffic as evidence in your Afterglow instance.",
  "permissions": ["alarms", "debugger", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Afterglow Traffic Capture" }
}
